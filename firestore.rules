    }

    match /wholesaler_batches/{batchId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
        || (
          resource.data.isExpired == false
          && resource.data.availableQty > 0
          && exists(/databases/$(database)/documents/pharmacy_profiles/$(request.auth.uid))
        )
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(batchId)
        && (
          isApprovedWholesalerOwner(incoming().wholesalerUid)
          || (
            isApprovedPharmacyOwner(request.auth.uid)
            && existing() != null
            && incoming().wholesalerUid == existing().wholesalerUid
            && incoming().productId == existing().productId
            && incoming().availableQty <= existing().availableQty
          )
        )
      );
      allow delete: if false;
    }

