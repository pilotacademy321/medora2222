      allow update: if false;
      allow delete: if isVerifiedUser()
        && existing().patientUid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Independent Multi-Employer Secretary Hiring & Portal Isolation Rules
    // -------------------------------------------------------------------------
    function isValidSecretaryInvitation(data, invitationId) {
      return data.keys().hasAll([
          'invitationId', 'employerType', 'employerUid', 'employerInstitutionId',
          'employerName', 'invitedByUid', 'secretaryUid', 'secretaryEmail',
          'proposedPermissions', 'status', 'expiresAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'invitationId', 'employerType', 'employerUid', 'employerInstitutionId',
          'employerName', 'employerEmail', 'invitedByUid', 'invitedByName',
          'secretaryUid', 'secretaryCode', 'secretaryEmail', 'secretaryName',
          'message', 'proposedPermissions', 'initialTasks', 'status',
          'expiresAt', 'respondedAt', 'revokedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.invitationId)
        && data.invitationId == invitationId
        && data.employerType in ['doctor', 'lab', 'pharmacy']
        && isValidId(data.employerUid)
        && isValidId(data.employerInstitutionId)
        && isReqString(data, 'employerName', 1, 160)
        && isOptString(data, 'employerEmail', 254)
        && isValidId(data.invitedByUid)
        && isOptString(data, 'invitedByName', 120)
        && isValidId(data.secretaryUid)
        && isOptString(data, 'secretaryCode', 32)
        && isReqString(data, 'secretaryEmail', 3, 254)
        && isOptString(data, 'secretaryName', 120)
        && isOptString(data, 'message', 1000)
        && data.proposedPermissions is list
        && data.proposedPermissions.size() <= 10
        && (!('initialTasks' in data) || (data.initialTasks is list && data.initialTasks.size() <= 15))
        && data.status in ['Pending', 'Accepted', 'Rejected', 'Expired', 'Revoked']
        && isReqString(data, 'expiresAt', 8, 40)
        && isOptString(data, 'respondedAt', 40)
        && isOptString(data, 'revokedAt', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecretaryEmployment(data, employmentId) {
      return data.keys().hasAll([
          'employmentId', 'invitationId', 'employerType', 'employerUid',
          'employerInstitutionId', 'employerName', 'secretaryUid', 'secretaryEmail',
          'status', 'permissions', 'assignedByUid', 'acceptedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'employmentId', 'invitationId', 'employerType', 'employerUid',
          'employerInstitutionId', 'employerName', 'employerSubtitle',
          'secretaryUid', 'secretaryCode', 'secretaryEmail', 'secretaryName', 'secretaryPhone',
          'status', 'permissions', 'assignedByUid', 'acceptedAt',
          'suspendedAt', 'terminatedAt', 'statusReason', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.employmentId)
        && data.employmentId == employmentId
        && isValidId(data.invitationId)
        && data.employerType in ['doctor', 'lab', 'pharmacy']
        && isValidId(data.employerUid)
        && isValidId(data.employerInstitutionId)
        && isReqString(data, 'employerName', 1, 160)
        && isOptString(data, 'employerSubtitle', 160)
        && isValidId(data.secretaryUid)
        && isOptString(data, 'secretaryCode', 32)
        && isReqString(data, 'secretaryEmail', 3, 254)
        && isOptString(data, 'secretaryName', 120)
        && isOptString(data, 'secretaryPhone', 32)
        && data.status in ['Active', 'Suspended', 'Terminated']
        && data.permissions is list
        && data.permissions.size() <= 10
        && isValidId(data.assignedByUid)
        && isReqString(data, 'acceptedAt', 8, 40)
        && isOptString(data, 'suspendedAt', 40)
        && isOptString(data, 'terminatedAt', 40)
        && isOptString(data, 'statusReason', 300)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecretaryTask(data, taskId) {
      return data.keys().hasAll([
          'taskId', 'employmentId', 'employerType', 'employerUid',
          'secretaryUid', 'title', 'priority', 'status', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'taskId', 'employmentId', 'employerType', 'employerUid', 'employerName',
          'secretaryUid', 'secretaryName', 'title', 'description', 'priority',
          'dueDate', 'status', 'createdByUid', 'createdByName', 'completedAt',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.taskId)
        && data.taskId == taskId
        && isValidId(data.employmentId)
        && data.employerType in ['doctor', 'lab', 'pharmacy']
        && isValidId(data.employerUid)
        && isOptString(data, 'employerName', 160)
        && isValidId(data.secretaryUid)
        && isOptString(data, 'secretaryName', 120)
        && isReqString(data, 'title', 1, 180)
        && isOptString(data, 'description', 1000)
        && data.priority in ['low', 'medium', 'high']
        && isOptString(data, 'dueDate', 32)
        && data.status in ['todo', 'in_progress', 'done']
        && isValidId(data.createdByUid)
        && isOptString(data, 'createdByName', 120)
        && isOptString(data, 'completedAt', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecretaryNotification(data, notificationId) {
      return data.keys().hasAll(['notificationId', 'secretaryUid', 'type', 'title', 'body', 'isRead', 'createdAt'])
        && data.keys().hasOnly([
          'notificationId', 'secretaryUid', 'type', 'title', 'body',
          'relatedId', 'employerType', 'employerName', 'isRead', 'createdAt'
        ])
        && isValidId(data.notificationId)
        && data.notificationId == notificationId
        && isValidId(data.secretaryUid)
        && data.type in [
          'invitation_received', 'invitation_revoked', 'permissions_updated',
          'employment_suspended', 'employment_reactivated', 'employment_terminated', 'task_assigned'
        ]
        && isReqString(data, 'title', 1, 200)
        && isReqString(data, 'body', 1, 600)
        && isOptString(data, 'relatedId', 128)
        && (!('employerType' in data) || data.employerType in ['doctor', 'lab', 'pharmacy'])
        && isOptString(data, 'employerName', 160)
        && data.isRead is bool
        && data.createdAt is timestamp;
    }

    function isValidSecretaryActivityLog(data, logId) {
      return data.keys().hasAll([
          'logId', 'employerUid', 'employerType', 'secretaryUid',
          'actorUid', 'actorRole', 'action', 'details', 'createdAt'
        ])
        && data.keys().hasOnly([
          'logId', 'employerUid', 'employerType', 'employerName',
          'employmentId', 'invitationId', 'secretaryUid', 'secretaryName',
          'actorUid', 'actorName', 'actorRole', 'action', 'details', 'createdAt'
        ])
        && isValidId(data.logId)
        && data.logId == logId
        && isValidId(data.employerUid)
        && data.employerType in ['doctor', 'lab', 'pharmacy']
        && isOptString(data, 'employerName', 160)
        && isOptString(data, 'employmentId', 128)
        && isOptString(data, 'invitationId', 128)
        && isValidId(data.secretaryUid)
        && isOptString(data, 'secretaryName', 120)
        && isValidId(data.actorUid)
        && isOptString(data, 'actorName', 120)
        && data.actorRole in ['employer', 'secretary']
        && isReqString(data, 'action', 2, 120)
        && isReqString(data, 'details', 1, 600)
        && data.createdAt is timestamp;
    }

    match /secretary_invitations/{invitationId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.secretaryUid == request.auth.uid
        || resource.data.employerUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(invitationId)
        && isValidSecretaryInvitation(incoming(), invitationId)
        && incoming().employerUid == request.auth.uid
        && incoming().invitedByUid == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
      );
      allow update: if isVerifiedUser()
        && isValidId(invitationId)
        && isValidSecretaryInvitation(incoming(), invitationId)
        && incoming().invitationId == existing().invitationId
        && incoming().employerUid == existing().employerUid
        && incoming().employerType == existing().employerType
        && incoming().secretaryUid == existing().secretaryUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().status == 'Pending'
            && existing().employerUid == request.auth.uid
            && incoming().status == 'Revoked'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'revokedAt', 'updatedAt'])
          )
          || (
            existing().status == 'Pending'
            && existing().secretaryUid == request.auth.uid
            && incoming().status in ['Accepted', 'Rejected']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'respondedAt', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /secretary_employments/{employmentId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.secretaryUid == request.auth.uid
        || resource.data.employerUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(employmentId)
        && isValidSecretaryEmployment(incoming(), employmentId)
        && incoming().secretaryUid == request.auth.uid
        && incoming().status == 'Active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/secretary_invitations/$(incoming().invitationId))
        && get(/databases/$(database)/documents/secretary_invitations/$(incoming().invitationId)).data.secretaryUid == request.auth.uid
        && get(/databases/$(database)/documents/secretary_invitations/$(incoming().invitationId)).data.employerUid == incoming().employerUid
        && get(/databases/$(database)/documents/secretary_invitations/$(incoming().invitationId)).data.status in ['Pending', 'Accepted']
      );
      allow update: if isVerifiedUser()
        && isValidId(employmentId)
        && isValidSecretaryEmployment(incoming(), employmentId)
        && incoming().employmentId == existing().employmentId
        && incoming().invitationId == existing().invitationId
        && incoming().employerUid == existing().employerUid
        && incoming().employerType == existing().employerType
        && incoming().secretaryUid == existing().secretaryUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'Terminated'
        && (
          isAdmin()
          || (
            existing().employerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'permissions', 'status', 'suspendedAt', 'terminatedAt', 'statusReason', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /secretary_tasks/{taskId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.secretaryUid == request.auth.uid
        || resource.data.employerUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(taskId)
        && isValidSecretaryTask(incoming(), taskId)
        && incoming().employerUid == request.auth.uid
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
      );
      allow update: if isVerifiedUser()
        && isValidId(taskId)
        && isValidSecretaryTask(incoming(), taskId)
        && incoming().taskId == existing().taskId
        && incoming().employmentId == existing().employmentId
        && incoming().employerUid == existing().employerUid
        && incoming().secretaryUid == existing().secretaryUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || existing().employerUid == request.auth.uid
          || (
            existing().secretaryUid == request.auth.uid
            && exists(/databases/$(database)/documents/secretary_employments/$(existing().employmentId))
            && get(/databases/$(database)/documents/secretary_employments/$(existing().employmentId)).data.status == 'Active'
            && get(/databases/$(database)/documents/secretary_employments/$(existing().employmentId)).data.secretaryUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /secretary_notifications/{notificationId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.secretaryUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(notificationId)
        && isValidSecretaryNotification(incoming(), notificationId)
        && incoming().createdAt == request.time
      );
      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidSecretaryNotification(incoming(), notificationId)
        && (
          isAdmin()
          || (
            existing().secretaryUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          )
        );
      allow delete: if false;
    }

    match /secretary_activity_logs/{logId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.secretaryUid == request.auth.uid
        || resource.data.employerUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(logId)
        && isValidSecretaryActivityLog(incoming(), logId)
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time
      );
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // MEDORA PHARMACY & MEDORA WHOLESALER Isolation & RBAC Rules
    // -------------------------------------------------------------------------
    function isApprovedPharmacyOwner(pharmacyUid) {
      return isVerifiedUser()
        && isValidId(pharmacyUid)
        && request.auth.uid == pharmacyUid
        && exists(/databases/$(database)/documents/pharmacy_profiles/$(pharmacyUid))
        && get(/databases/$(database)/documents/pharmacy_profiles/$(pharmacyUid)).data.status == 'Approved';
    }

    function isApprovedWholesalerOwner(wholesalerUid) {
      return isVerifiedUser()
        && isValidId(wholesalerUid)
        && request.auth.uid == wholesalerUid
        && exists(/databases/$(database)/documents/wholesaler_profiles/$(wholesalerUid))
        && get(/databases/$(database)/documents/wholesaler_profiles/$(wholesalerUid)).data.status == 'Approved';
    }

    match /medora_medicines/{medicineId} {
      allow get, list: if isVerifiedUser();
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(medicineId)
        && (
          isApprovedPharmacyOwner(request.auth.uid)
          || isApprovedWholesalerOwner(request.auth.uid)
        )
      );
      allow delete: if false;
    }

    match /pharmacy_products/{productId} {
      allow get, list: if isAdmin()
        || (resource.data.isActive == true && (!('isPublishedToPatients' in resource.data) || resource.data.isPublishedToPatients == true))
        || (isVerifiedUser() && resource.data.pharmacyUid == request.auth.uid)
        || (isVerifiedUser() && isApprovedDoctorOwner(request.auth.uid) && resource.data.isActive == true);
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(productId)
        && isApprovedPharmacyOwner(incoming().pharmacyUid)
      );
      allow delete: if false;
    }

    match /pharmacy_batches/{batchId} {
      allow get, list: if isAdmin()
        || (resource.data.isExpired == false && resource.data.availableQty > 0)
        || (isVerifiedUser() && resource.data.pharmacyUid == request.auth.uid);
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(batchId)
        && (
          isApprovedPharmacyOwner(incoming().pharmacyUid)
          || (
            isVerifiedUser()
            && existing() != null
            && incoming().pharmacyUid == existing().pharmacyUid
            && incoming().productId == existing().productId
            && incoming().availableQty <= existing().availableQty
          )
        )
      );
      allow delete: if false;
    }

    match /pharmacy_inventory_movements/{movementId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.pharmacyUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(movementId)
        && isValidId(incoming().pharmacyUid)
        && (isApprovedPharmacyOwner(incoming().pharmacyUid) || incoming().actorUid == request.auth.uid)
      );
      allow update, delete: if false;
    }

    match /pharmacy_orders/{orderId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.pharmacyUid == request.auth.uid
        || resource.data.patientUid == request.auth.uid
        || resource.data.doctorUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(orderId)
        && (incoming().patientUid == request.auth.uid || isApprovedPharmacyOwner(incoming().pharmacyUid))
      );
      allow update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(orderId)
        && existing() != null
        && (
          isApprovedPharmacyOwner(existing().pharmacyUid)
          || existing().patientUid == request.auth.uid
        )
      );
      allow delete: if false;
    }

    match /pharmacy_doctor_orders/{orderId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.pharmacyUid == request.auth.uid
        || resource.data.doctorUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(orderId)
        && isApprovedDoctorOwner(incoming().doctorUid)
        && incoming().orderId == orderId
      );
      allow update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(orderId)
        && existing() != null
        && (
          isApprovedPharmacyOwner(existing().pharmacyUid)
          || isApprovedDoctorOwner(existing().doctorUid)
        )
      );
      allow delete: if false;
    }

