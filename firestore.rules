    match /pharmacy_notifications/{notificationId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.pharmacyUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(notificationId)
        && isValidId(incoming().pharmacyUid)
        && incoming().isRead == false
        && isReqString(incoming(), 'title', 1, 200)
        && isReqString(incoming(), 'body', 1, 600)
      );
      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && (
          isAdmin()
          || (
            existing().pharmacyUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          )
        );
      allow delete: if false;
    }

    match /pharmacy_special_offers/{offerId} {
      allow get, list: if isAdmin()
        || (isVerifiedUser() && resource.data.pharmacyUid == request.auth.uid)
        || (resource.data.approvalStatus == 'approved' && resource.data.isActive == true);
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(offerId)
        && isApprovedPharmacyOwner(incoming().pharmacyUid)
      );
