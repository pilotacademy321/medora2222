        && isValidId(orderId)
        && isApprovedPharmacyOwner(incoming().pharmacyUid)
      );
      allow update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(orderId)
        && existing() != null
        && (
          isApprovedWholesalerOwner(existing().wholesalerUid)
          || isApprovedPharmacyOwner(existing().pharmacyUid)
        )
      );
      allow delete: if false;
    }

    match /wholesaler_shipments/{shipmentId} {
      allow get, list: if isVerifiedUser() && (
