    match /wholesaler_purchase_orders/{poId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(poId)
        && isApprovedWholesalerOwner(incoming().wholesalerUid)
      );
      allow delete: if false;
    }

    match /wholesaler_invoices/{invoiceId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
        || resource.data.pharmacyUid == request.auth.uid
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(invoiceId)
        && (isApprovedWholesalerOwner(incoming().wholesalerUid) || isApprovedPharmacyOwner(incoming().pharmacyUid))
      );
      allow delete: if false;
    }

    match /wholesaler_payments/{paymentId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
        || resource.data.pharmacyUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(paymentId)
        && isApprovedWholesalerOwner(incoming().wholesalerUid)
      );
      allow update, delete: if false;
    }

    match /wholesaler_returns/{returnId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
        || resource.data.pharmacyUid == request.auth.uid
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(returnId)
        && (isApprovedWholesalerOwner(incoming().wholesalerUid) || isApprovedPharmacyOwner(incoming().pharmacyUid))
      );
      allow delete: if false;
    }

    match /wholesaler_staff/{staffId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
        || resource.data.uid == request.auth.uid
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(staffId)
        && isApprovedWholesalerOwner(incoming().wholesalerUid)
      );
      allow delete: if false;
    }

    match /wholesaler_communications/{messageId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
        || resource.data.senderUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(messageId)
        && (isApprovedWholesalerOwner(incoming().wholesalerUid) || incoming().senderUid == request.auth.uid)
      );
      allow update, delete: if false;
    }

    match /wholesaler_notifications/{notificationId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(notificationId)
        && isValidId(incoming().wholesalerUid)
        && incoming().isRead == false
        && isReqString(incoming(), 'title', 1, 200)
        && isReqString(incoming(), 'body', 1, 600)
      );
      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && (
          isAdmin()
          || (
            existing().wholesalerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          )
        );
      allow delete: if false;
    }

    match /wholesaler_audit_logs/{logId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(logId)
        && isApprovedWholesalerOwner(incoming().wholesalerUid)
      );
      allow update, delete: if false;
    }

    match /bulk_import_jobs/{jobId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(jobId)
        && incoming().ownerUid == request.auth.uid
      );
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // UNIFIED 3-PARTY COMMERCE RECEIPTS, MULTI-PARTY MESSAGING & OPS LOGS
    // -------------------------------------------------------------------------
    function isValidMedoraReceipt(data, receiptId) {
      return data.keys().hasAll([
          'receiptId', 'receiptNumber', 'transactionType', 'orderId', 'orderNumber',
          'sellerUid', 'sellerRole', 'sellerName', 'buyerUid', 'buyerRole', 'buyerName',
          'items', 'totalAmountIqd', 'paymentMethod', 'paymentStatus', 'fulfillmentType',
          'status', 'issuedAt', 'completedAt'
        ])
        && isValidId(receiptId)
        && data.receiptId == receiptId
        && isReqString(data, 'receiptNumber', 6, 64)
        && data.transactionType in ['wholesaler_to_pharmacy', 'pharmacy_to_doctor', 'pharmacy_to_patient']
        && isValidId(data.orderId)
        && isReqString(data, 'orderNumber', 3, 64)
        && isValidId(data.sellerUid)
        && data.sellerRole in ['wholesaler', 'pharmacy']
        && isReqString(data, 'sellerName', 1, 160)
        && isValidId(data.buyerUid)
        && data.buyerRole in ['pharmacy', 'doctor', 'patient']
        && isReqString(data, 'buyerName', 1, 160)
        && data.items is list
        && data.items.size() >= 1
        && data.items.size() <= 200
        && data.totalAmountIqd is number
        && data.totalAmountIqd >= 0
        && data.paymentMethod in ['direct', 'credit_account', 'cash_on_delivery', 'cash_on_pickup']
        && data.paymentStatus in ['paid', 'partial', 'credit_open']
        && data.fulfillmentType in ['seller_delivery', 'buyer_pickup']
        && data.status in ['active', 'amended', 'voided']
        && isReqString(data, 'issuedAt', 8, 40)
        && isReqString(data, 'completedAt', 8, 40);
    }

    match /medora_receipts/{receiptId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.sellerUid == request.auth.uid
        || resource.data.buyerUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidMedoraReceipt(incoming(), receiptId)
        && (incoming().sellerUid == request.auth.uid || incoming().buyerUid == request.auth.uid)
        && incoming().status == 'active'
      );
      allow update: if isVerifiedUser()
        && isValidMedoraReceipt(incoming(), receiptId)
        && incoming().receiptId == existing().receiptId
        && incoming().orderId == existing().orderId
        && incoming().sellerUid == existing().sellerUid
        && incoming().buyerUid == existing().buyerUid
        && (
          isAdmin()
          || (
            (existing().sellerUid == request.auth.uid || existing().buyerUid == request.auth.uid)
            && incoming().status == existing().status
            && incoming().totalAmountIqd == existing().totalAmountIqd
            && incoming().diff(existing()).affectedKeys().hasOnly(['reprintCount', 'lastPrintedAt', 'auditHistory', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /medora_receipt_events/{eventId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.sellerUid == request.auth.uid
        || resource.data.buyerUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(eventId)
        && incoming().eventId == eventId
        && incoming().actorUid == request.auth.uid
      );
      allow update, delete: if false;
    }

    match /medora_threads/{threadId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || request.auth.uid in resource.data.participantUids
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(threadId)
        && incoming().threadId == threadId
        && incoming().participantUids is list
        && incoming().participantUids.size() >= 2
        && incoming().participantUids.size() <= 4
        && request.auth.uid in incoming().participantUids
      );
      allow update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(threadId)
        && existing() != null
        && request.auth.uid in existing().participantUids
        && incoming().participantUids == existing().participantUids
      );
      allow delete: if false;
    }

    match /medora_thread_messages/{messageId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || request.auth.uid in resource.data.participantUids
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(messageId)
        && incoming().messageId == messageId
        && incoming().senderUid == request.auth.uid
        && incoming().participantUids is list
        && request.auth.uid in incoming().participantUids
      );
      allow update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(messageId)
        && existing() != null
        && request.auth.uid in existing().participantUids
        && incoming().diff(existing()).affectedKeys().hasOnly(['readByUids', 'readAtByUid'])
      );
      allow delete: if false;
    }

    match /medora_operational_errors/{errorId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(errorId)
        && incoming().errorId == errorId
      );
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /medora_counters/{counterId} {
      allow get: if isVerifiedUser();
      allow list: if isAdmin();
      allow create, update: if isVerifiedUser()
        && isValidId(counterId)
        && incoming().counterId == counterId
        && incoming().seq is number
        && incoming().seq >= 1;
      allow delete: if false;
    }

  }
}
