        && isValidId(shipmentId)
        && isApprovedWholesalerOwner(incoming().wholesalerUid)
      );
      allow delete: if false;
    }

    match /wholesaler_suppliers/{supplierId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
      );
      allow create, update: if isAdmin() || (
