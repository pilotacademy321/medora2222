    match /secretary_profiles/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isOwner(uid)
        && isValidId(uid)
        && isValidSecretaryProfile(incoming(), uid)
        && incoming().permissionsGranted == false
        && incoming().status in ['Draft', 'Submitted', 'Approved']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidSecretaryProfile(incoming(), uid)
        && (
          isAdmin()
          || (
            isOwner(uid)
            && incoming().permissionsGranted == existing().permissionsGranted
            && incoming().status == existing().status
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'dateOfBirth', 'gender', 'avatarUrl', 'governorate', 'district',
              'phone', 'educationQualification', 'previousExperience', 'bio',
              'targetInstitutionName', 'invitationCode', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /pharmacy_profiles/{uid} {
      allow get: if isValidId(uid) && (
        isAdmin()
        || (isSignedIn() && isOwner(uid))
        || (resource != null && resource.data.status == 'Approved')
      );
      allow list: if isAdmin() || (resource.data.status == 'Approved');
      allow create: if isVerifiedUser()
        && isOwner(uid)
        && isValidId(uid)
        && isValidPharmacyProfile(incoming(), uid)
        && incoming().status in ['Draft', 'Submitted']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidPharmacyProfile(incoming(), uid)
        && (
          isAdmin()
          || (
            isOwner(uid)
            && existing().status in ['Draft', 'Requires Changes', 'Rejected']
            && incoming().status in ['Draft', 'Submitted']
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'pharmacyNameAr', 'pharmacyNameEn', 'ownerFullName',
              'responsiblePharmacistName', 'pharmacistSyndicateNumber', 'pharmacyLicenseNumber',
              'licensingAuthority', 'licenseExpiryDate', 'professionalPhone', 'email',
              'governorate', 'district', 'address', 'mapLocationUrl', 'latitude', 'longitude',
              'workingDaysAndHours', 'is24Hours', 'deliveryAvailable', 'pickupAvailable',
              'licenseDocuments', 'institutionId', 'status', 'updatedAt'
            ])
          )
          || (
            isOwner(uid)
            && existing().status == 'Approved'
            && incoming().status == existing().status
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'pharmacyNameAr', 'pharmacyNameEn', 'professionalPhone', 'governorate', 'district',
              'address', 'mapLocationUrl', 'latitude', 'longitude', 'workingDaysAndHours',
              'is24Hours', 'deliveryAvailable', 'pickupAvailable', 'deliveryZones',
              'acceptedPaymentMethods', 'minimumOrderIqd', 'taxNumber',
              'logoUrl', 'logoPath', 'coverImageUrl', 'coverImagePath',
              'taglineAr', 'taglineEn', 'aboutAr', 'aboutEn', 'publicSlug',
              'promotionalBannerTitleAr', 'promotionalBannerTitleEn', 'promotionalBannerBodyAr',
              'promotionalBannerBodyEn', 'promotionalBannerImageUrl', 'promotionalBannerImagePath',
              'marketingApprovalStatus', 'featuredStatus', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /wholesaler_profiles/{uid} {
      allow get: if isValidId(uid) && (
        isAdmin()
        || (isSignedIn() && isOwner(uid))
        || (isVerifiedUser() && resource != null && resource.data.status == 'Approved')
      );
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.status == 'Approved');
      allow create: if isVerifiedUser()
        && isOwner(uid)
        && isValidId(uid)
        && isValidWholesalerProfile(incoming(), uid)
        && incoming().status in ['Draft', 'Submitted']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidWholesalerProfile(incoming(), uid)
        && (
          isAdmin()
          || (
            isOwner(uid)
            && existing().status in ['Draft', 'Requires Changes', 'Rejected']
            && incoming().status in ['Draft', 'Submitted']
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'wholesalerNameAr', 'wholesalerNameEn', 'ownerFullName', 'legalEntityName',
              'warehouseLicenseNumber', 'healthAuthorityLicenseNumber', 'licensingAuthority',
              'licenseExpiryDate', 'professionalPhone', 'email', 'governorate', 'district',
              'warehouseAddress', 'mapLocationUrl', 'latitude', 'longitude',
              'workingDaysAndHours', 'supportedGovernorates', 'minimumOrderIqd',
              'licenseDocuments', 'institutionId', 'status', 'updatedAt'
            ])
          )
          || (
            isOwner(uid)
            && existing().status == 'Approved'
            && incoming().status == existing().status
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'professionalPhone', 'warehouseAddress', 'mapLocationUrl', 'latitude', 'longitude',
              'workingDaysAndHours', 'supportedGovernorates', 'minimumOrderIqd',
              'creditEnabledByDefault', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /registration_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (resource == null || existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidRegistrationRequest(incoming(), requestId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('reviewReason' in incoming()) || incoming().reviewReason == '')
        && (!('reviewInstructions' in incoming()) || incoming().reviewInstructions == '')
        && (
          (incoming().portalType == 'patient' && incoming().status == 'Approved' && incoming().activationRule == 'patient_instant')
          || (incoming().portalType in ['doctor', 'lab', 'pharmacy', 'wholesaler'] && incoming().status == 'Submitted' && incoming().activationRule == 'admin_approval')
          || (incoming().portalType == 'secretary' && incoming().status == 'Submitted' && incoming().activationRule == 'institution_approval')
        );
      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && isValidRegistrationRequest(incoming(), requestId)
        && incoming().uid == existing().uid
        && incoming().requestId == existing().requestId
        && incoming().requestNumber == existing().requestNumber
        && incoming().portalType == existing().portalType
        && incoming().activationRule == existing().activationRule
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'reviewReason', 'reviewInstructions', 'updatedAt'
            ])
          )
          || (
            existing().uid == request.auth.uid
            && existing().status in ['Draft', 'Requires Changes']
            && incoming().status == 'Submitted'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'acceptedTerms', 'submittedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /institutions/{institutionId} {
      allow get: if isSignedIn() && isValidId(institutionId) && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(institutionId)
        && isValidInstitution(incoming(), institutionId)
        && incoming().ownerUid == request.auth.uid
        && incoming().status == 'pending_approval'
        && !('subscriptionStatus' in incoming())
        && !('subscriptionPlan' in incoming())
        && !('subscriptionExpiresAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(institutionId)
        && isValidInstitution(incoming(), institutionId)
        && incoming().institutionId == existing().institutionId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerUid == request.auth.uid
            && existing().status in ['pending_approval', 'rejected']
            && incoming().status == 'pending_approval'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'nameAr', 'nameEn', 'governorate', 'district', 'address', 'licenseNumber', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /institution_members/{memberId} {
      allow get: if isSignedIn() && isValidId(memberId) && (resource == null || existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(memberId)
        && isValidInstitutionMember(incoming(), memberId)
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending_approval'
        && (
          (incoming().role == 'owner')
          || (incoming().role == 'secretary' && incoming().permissions.size() == 0)
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(memberId)
        && isValidInstitutionMember(incoming(), memberId)
        && isAdmin()
        && incoming().memberId == existing().memberId
        && incoming().institutionId == existing().institutionId
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /admin_roles/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      // Only the verified sole Super Admin email may bootstrap or update their own active role doc
      allow create: if isBootstrapSuperAdminEmail()
        && isOwner(uid)
        && isValidId(uid)
        && isValidAdminRole(incoming(), uid)
        && incoming().email.lower() == 'aqbs250@gmail.com'
        && incoming().active == true
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isBootstrapSuperAdminEmail()
        && isOwner(uid)
        && isValidId(uid)
        && isValidAdminRole(incoming(), uid)
        && incoming().email.lower() == 'aqbs250@gmail.com'
        && incoming().active == true
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidAuditLog(incoming(), logId)
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /admin_messages/{messageId} {
      allow get: if isAdmin() && isValidId(messageId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(messageId)
        && isValidAdminMessage(incoming(), messageId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(messageId)
        && isValidAdminMessage(incoming(), messageId)
        && incoming().messageId == existing().messageId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isRead', 'updatedAt']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // MEDORA DOCTOR Clinical & Directory Rules
    // -------------------------------------------------------------------------
    function isApprovedDoctorOwner(doctorUid) {
      return isVerifiedUser()
        && isValidId(doctorUid)
        && request.auth.uid == doctorUid
        && exists(/databases/$(database)/documents/doctor_profiles/$(doctorUid))
        && get(/databases/$(database)/documents/doctor_profiles/$(doctorUid)).data.status == 'Approved';
    }

    match /doctor_public_cards/{doctorUid} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isApprovedDoctorOwner(doctorUid);
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || isApprovedDoctorOwner(resource.data.doctorUid)
        || resource.data.patientUid == request.auth.uid
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(appointmentId)
        && isApprovedDoctorOwner(incoming().doctorUid)
      );
      allow delete: if false;
    }

    match /appointment_slots/{slotKey} {
      allow get, list: if isVerifiedUser();
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(slotKey)
        && isApprovedDoctorOwner(incoming().doctorUid)
      );
      allow delete: if false;
    }

    match /doctor_patients/{patientRecordId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || isApprovedDoctorOwner(resource.data.doctorUid)
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(patientRecordId)
        && isApprovedDoctorOwner(incoming().doctorUid)
      );
      allow delete: if false;
    }

    match /patient_visits/{visitId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || isApprovedDoctorOwner(resource.data.doctorUid)
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(visitId)
        && isApprovedDoctorOwner(incoming().doctorUid)
      );
      allow delete: if false;
    }

    match /prescriptions/{prescriptionId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || isApprovedDoctorOwner(resource.data.doctorUid)
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(prescriptionId)
        && isApprovedDoctorOwner(incoming().doctorUid)
      );
      allow delete: if false;
    }

    match /diagnostic_orders/{orderId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || isApprovedDoctorOwner(resource.data.doctorUid)
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(orderId)
        && isApprovedDoctorOwner(incoming().doctorUid)
      );
      allow delete: if false;
    }

    match /doctor_conversations/{conversationId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || isApprovedDoctorOwner(resource.data.doctorUid)
        || resource.data.patientUid == request.auth.uid
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(conversationId)
        && (isApprovedDoctorOwner(incoming().doctorUid) || incoming().patientUid == request.auth.uid)
      );
      allow delete: if false;
    }

    match /doctor_messages/{messageId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || isApprovedDoctorOwner(resource.data.doctorUid)
        || resource.data.patientUid == request.auth.uid
        || resource.data.senderUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(messageId)
        && (isApprovedDoctorOwner(incoming().doctorUid) || incoming().senderUid == request.auth.uid)
      );
      allow update, delete: if false;
    }

    match /doctor_audit_logs/{logId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || isApprovedDoctorOwner(resource.data.doctorUid)
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(logId)
        && isApprovedDoctorOwner(incoming().doctorUid)
      );
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // MEDORA PATIENT & Platform Ads / Reviews / Feedback Rules
    // -------------------------------------------------------------------------
    function isValidMedoraAd(data, adId) {
      return data.adId == adId
        && data.source == 'super_admin'
        && data.entityType in ['doctor', 'lab', 'pharmacy', 'wholesaler', 'radiology_info', 'platform_service']
        && data.status in ['draft', 'published', 'paused', 'expired']
        && data.active is bool
        && data.imageUrl is string
        && data.imageUrl.size() > 0
        && (!('title' in data) || (data.title is string && data.title.size() <= 140))
        && (!('description' in data) || (data.description is string && data.description.size() <= 600))
        && (!('targetPortals' in data) || (data.targetPortals is list && data.targetPortals.size() <= 6))
        && (!('destinationTarget' in data) || (data.destinationTarget is string && data.destinationTarget.size() <= 240))
        && (!('ctaLabelAr' in data) || (data.ctaLabelAr is string && data.ctaLabelAr.size() <= 80))
        && (!('ctaLabelEn' in data) || (data.ctaLabelEn is string && data.ctaLabelEn.size() <= 80));
    }

    match /medora_ads/{adId} {
      allow get: if isAdmin() || (isValidId(adId) && (
        resource == null
        || (resource.data.source == 'super_admin'
          && resource.data.status == 'published'
          && resource.data.active == true)
      ));
      allow list: if isAdmin() || (
        resource.data.source == 'super_admin'
        && resource.data.status == 'published'
        && resource.data.active == true
      );
      allow create, update: if isAdmin() && isValidId(adId) && isValidMedoraAd(incoming(), adId);
      allow delete: if isAdmin() && isValidId(adId);
    }

    match /medora_ad_assets/{assetId} {
      allow get: if isValidId(assetId);
      allow list, create, update, delete: if isAdmin() && isValidId(assetId);
    }

    match /ad_events/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(eventId)
        && incoming().eventId == eventId
        && incoming().adId is string
        && incoming().adId.size() > 0
        && incoming().adId.size() <= 128
        && incoming().eventType in ['impression', 'click']
        && incoming().portal in ['entry', 'patient', 'pharmacy', 'lab', 'doctor', 'wholesaler'];
      allow update, delete: if false;
    }

    match /patient_favorites/{favoriteId} {
      allow get: if isVerifiedUser() && isValidId(favoriteId) && (
