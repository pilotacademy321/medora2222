    // -------------------------------------------------------------------------
    // MEDORA LAB (Multi-Tenant LIMS) Isolation & RBAC Rules
    // -------------------------------------------------------------------------
    function isApprovedLabOwner(labUid) {
      return isVerifiedUser()
        && isValidId(labUid)
        && request.auth.uid == labUid
        && exists(/databases/$(database)/documents/lab_profiles/$(labUid))
        && get(/databases/$(database)/documents/lab_profiles/$(labUid)).data.status == 'Approved';
    }

