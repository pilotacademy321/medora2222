    match /wholesaler_products/{productId} {
      allow get, list: if isVerifiedUser() && (
        isAdmin()
        || resource.data.wholesalerUid == request.auth.uid
        || (
          resource.data.isActive == true
          && exists(/databases/$(database)/documents/pharmacy_profiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/pharmacy_profiles/$(request.auth.uid)).data.status == 'Approved'
        )
      );
      allow create, update: if isAdmin() || (
        isVerifiedUser()
        && isValidId(productId)
        && isApprovedWholesalerOwner(incoming().wholesalerUid)
      );
