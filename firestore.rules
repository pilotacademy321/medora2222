        || resource.data.wholesalerUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isVerifiedUser()
        && isValidId(movementId)
        && (isApprovedWholesalerOwner(incoming().wholesalerUid) || incoming().actorUid == request.auth.uid)
      );
      allow update, delete: if false;
    }

    match /wholesaler_credit_policies/{policyId} {
      allow get, list: if isVerifiedUser() && (
