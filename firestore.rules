      );
      allow create: if isVerifiedUser()
        && isValidId(favoriteId)
        && incoming().patientUid == request.auth.uid
        && isValidId(incoming().doctorUid);
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(favoriteId)
        && (existing().patientUid == request.auth.uid || isAdmin());
    }

