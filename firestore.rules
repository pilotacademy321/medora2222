rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all access unless explicitly permitted below
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Hardened Global Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOptString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isReqString(data, key, minLen, maxLen) {
      return (key in data) && (data[key] is string) && data[key].size() >= minLen && data[key].size() <= maxLen;
    }

    function isBootstrapSuperAdminEmail() {
      return isVerifiedUser()
        && ('email' in request.auth.token)
        && (request.auth.token.email is string)
        && request.auth.token.email.lower() == 'aqbs250@gmail.com';
    }

    function isAdmin() {
      return isBootstrapSuperAdminEmail()
        && (
          !exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid))
          || (
            ('email' in get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data)
            && (get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.email is string)
            && get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.email.lower() == 'aqbs250@gmail.com'
            && get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.role == 'super_admin'
            && get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.active == true
          )
        );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserPayload(data, uid) {
      return data.keys().hasAll([
          'uid', 'email', 'googleName', 'accountStatus',
          'selectedPortal', 'registrationCompleted', 'personalProfileCompleted',
          'createdAt', 'lastLoginAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'googleName', 'photoUrl', 'accountStatus',
          'selectedPortal', 'registrationCompleted', 'personalProfileCompleted',
          'fullName', 'dateOfBirth', 'age', 'gender', 'governorate',
          'district', 'address', 'phone', 'phoneVerified', 'phoneVerifiedAt',
          'avatarUrl', 'avatarPath',
          'createdAt', 'lastLoginAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && isReqString(data, 'email', 3, 254)
        && isReqString(data, 'googleName', 1, 120)
        && isOptString(data, 'photoUrl', 1000)
        && data.accountStatus in ['pending_profile', 'profile_completed', 'pending_review', 'active', 'restricted', 'suspended']
        && data.selectedPortal in ['none', 'patient', 'doctor', 'lab', 'secretary', 'pharmacy', 'wholesaler']
        && data.registrationCompleted is bool
        && data.personalProfileCompleted is bool
        && isOptString(data, 'fullName', 120)
        && isOptString(data, 'dateOfBirth', 20)
        && (!('age' in data) || (data.age is number && data.age >= 0 && data.age <= 130))
        && (!('gender' in data) || data.gender in ['male', 'female', 'unspecified'])
        && isOptString(data, 'governorate', 80)
        && isOptString(data, 'district', 80)
        && isOptString(data, 'address', 240)
        && isOptString(data, 'phone', 32)
        && (!('phoneVerified' in data) || data.phoneVerified is bool)
        && isOptString(data, 'phoneVerifiedAt', 64)
        && isOptString(data, 'avatarUrl', 1000)
        && isOptString(data, 'avatarPath', 500)
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPatientProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'fullName', 'dateOfBirth', 'gender', 'governorate',
          'district', 'address', 'acceptedPolicy', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'dateOfBirth', 'gender', 'governorate',
          'district', 'address', 'phone', 'phoneVerified', 'avatarUrl', 'avatarPath',
          'emergencyContactName', 'emergencyContactPhone', 'emergencyContactRelation',
          'preferences', 'acceptedPolicy', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && isReqString(data, 'fullName', 2, 120)
        && isReqString(data, 'dateOfBirth', 4, 20)
        && data.gender in ['male', 'female']
        && isReqString(data, 'governorate', 2, 80)
        && isReqString(data, 'district', 2, 80)
        && isReqString(data, 'address', 2, 240)
        && isOptString(data, 'phone', 32)
        && (!('phoneVerified' in data) || data.phoneVerified is bool)
        && isOptString(data, 'avatarUrl', 1000)
        && isOptString(data, 'avatarPath', 500)
        && isOptString(data, 'emergencyContactName', 120)
        && isOptString(data, 'emergencyContactPhone', 32)
        && isOptString(data, 'emergencyContactRelation', 60)
        && (!('preferences' in data) || data.preferences is map)
        && data.acceptedPolicy == true
        && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDoctorProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'fullName', 'dateOfBirth', 'gender', 'governorate', 'district',
          'professionalPhone', 'email', 'degree', 'university', 'specialty',
          'clinicName', 'workAddress', 'workDaysAndHours',
          'consultationDurationMinutes', 'consultationFee', 'hourlyAppointmentLimit',
          'bookingConfirmationMode', 'licenseNumber', 'licensingAuthority',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'dateOfBirth', 'gender', 'avatarUrl', 'avatarPath', 'governorate', 'district',
          'professionalPhone', 'email', 'degree', 'university', 'specialty', 'subSpecialty',
          'experienceYears', 'languages', 'clinicName', 'workAddress', 'workDaysAndHours',
          'consultationDurationMinutes', 'consultationFee', 'hourlyAppointmentLimit',
          'bookingConfirmationMode', 'licenseNumber', 'licensingAuthority', 'licenseExpiryDate',
          'verificationDocuments', 'institutionId', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && isReqString(data, 'fullName', 2, 120)
        && isReqString(data, 'dateOfBirth', 4, 20)
        && data.gender in ['male', 'female']
        && isOptString(data, 'avatarUrl', 1000)
        && isOptString(data, 'avatarPath', 500)
        && isReqString(data, 'governorate', 2, 80)
        && isReqString(data, 'district', 2, 80)
        && isReqString(data, 'professionalPhone', 6, 32)
        && isReqString(data, 'email', 3, 254)
        && isReqString(data, 'degree', 2, 120)
        && isReqString(data, 'university', 2, 160)
        && isReqString(data, 'specialty', 2, 120)
        && isOptString(data, 'subSpecialty', 120)
        && (!('experienceYears' in data) || (data.experienceYears is number && data.experienceYears >= 0 && data.experienceYears <= 80))
        && (!('languages' in data) || (data.languages is list && data.languages.size() <= 10 && (data.languages.size() == 0 || data.languages[0] is string)))
        && isReqString(data, 'clinicName', 2, 160)
        && isReqString(data, 'workAddress', 2, 240)
        && isReqString(data, 'workDaysAndHours', 2, 240)
        && data.consultationDurationMinutes is number && data.consultationDurationMinutes >= 5 && data.consultationDurationMinutes <= 240
        && data.consultationFee is number && data.consultationFee >= 0 && data.consultationFee <= 10000000
        && data.hourlyAppointmentLimit is number && data.hourlyAppointmentLimit >= 1 && data.hourlyAppointmentLimit <= 60
        && data.bookingConfirmationMode in ['manual', 'auto']
        && isReqString(data, 'licenseNumber', 2, 80)
        && isReqString(data, 'licensingAuthority', 2, 120)
        && isOptString(data, 'licenseExpiryDate', 20)
        && (!('verificationDocuments' in data) || (data.verificationDocuments is list && data.verificationDocuments.size() <= 10 && (data.verificationDocuments.size() == 0 || data.verificationDocuments[0] is map)))
        && isOptString(data, 'institutionId', 128)
        && data.status in ['Draft', 'Submitted', 'Under Review', 'Approved', 'Rejected', 'Requires Changes']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLabProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'managerFullName', 'managerDateOfBirth', 'managerGender', 'professionalPhone',
          'labNameAr', 'labNameEn', 'directorName', 'governorate', 'district', 'address',
          'licenseNumber', 'licensingAuthority', 'technicalDirectorName',
          'labServices', 'workDaysAndHours', 'hourlyBookingLimit', 'bookingConfirmationMode',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'managerFullName', 'managerDateOfBirth', 'managerGender', 'managerAvatarUrl', 'avatarPath', 'professionalPhone',
          'labNameAr', 'labNameEn', 'directorName', 'governorate', 'district', 'address',
          'mapLocationUrl', 'latitude', 'longitude',
          'licenseNumber', 'licensingAuthority', 'licenseExpiryDate', 'licenseDocuments', 'technicalDirectorName',
          'labServices', 'serviceCatalog', 'workDaysAndHours', 'hourlyBookingLimit', 'bookingConfirmationMode',
          'homeCollectionEnabled', 'homeCollectionFeeIqd', 'averageRating', 'reviewCount',
          'institutionId', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && isReqString(data, 'managerFullName', 2, 120)
        && isReqString(data, 'managerDateOfBirth', 4, 20)
        && data.managerGender in ['male', 'female']
        && isOptString(data, 'managerAvatarUrl', 1000)
        && isOptString(data, 'avatarPath', 500)
        && isReqString(data, 'professionalPhone', 6, 32)
        && isReqString(data, 'labNameAr', 2, 160)
        && isReqString(data, 'labNameEn', 2, 160)
        && isReqString(data, 'directorName', 2, 120)
        && isReqString(data, 'governorate', 2, 80)
        && isReqString(data, 'district', 2, 80)
        && isReqString(data, 'address', 2, 240)
        && isOptString(data, 'mapLocationUrl', 500)
        && (!('latitude' in data) || data.latitude is number)
        && (!('longitude' in data) || data.longitude is number)
        && isReqString(data, 'licenseNumber', 2, 80)
        && isReqString(data, 'licensingAuthority', 2, 120)
        && isOptString(data, 'licenseExpiryDate', 24)
        && (!('licenseDocuments' in data) || (data.licenseDocuments is list && data.licenseDocuments.size() <= 10 && (data.licenseDocuments.size() == 0 || data.licenseDocuments[0] is map)))
        && isReqString(data, 'technicalDirectorName', 2, 120)
        && data.labServices is list && data.labServices.size() <= 50 && (data.labServices.size() == 0 || data.labServices[0] is string)
        && (!('serviceCatalog' in data) || (data.serviceCatalog is list && data.serviceCatalog.size() <= 150))
        && isReqString(data, 'workDaysAndHours', 2, 240)
        && data.hourlyBookingLimit is number && data.hourlyBookingLimit >= 1 && data.hourlyBookingLimit <= 200
        && data.bookingConfirmationMode in ['manual', 'auto']
        && (!('homeCollectionEnabled' in data) || data.homeCollectionEnabled is bool)
        && (!('homeCollectionFeeIqd' in data) || (data.homeCollectionFeeIqd is number && data.homeCollectionFeeIqd >= 0))
        && (!('averageRating' in data) || (data.averageRating is number && data.averageRating >= 0 && data.averageRating <= 5))
        && (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0))
        && isOptString(data, 'institutionId', 128)
        && data.status in ['Draft', 'Submitted', 'Under Review', 'Approved', 'Rejected', 'Requires Changes']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecretaryProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'fullName', 'dateOfBirth', 'gender', 'governorate', 'district',
          'phone', 'educationQualification', 'permissionsGranted', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'secretaryCode', 'email', 'fullName', 'dateOfBirth', 'gender', 'avatarUrl', 'governorate', 'district',
          'phone', 'educationQualification', 'previousExperience', 'bio',
          'targetInstitutionName', 'invitationCode', 'permissionsGranted',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && isOptString(data, 'secretaryCode', 32)
        && isOptString(data, 'email', 254)
        && isReqString(data, 'fullName', 2, 120)
        && isReqString(data, 'dateOfBirth', 4, 20)
        && data.gender in ['male', 'female']
        && isOptString(data, 'avatarUrl', 1000)
        && isReqString(data, 'governorate', 2, 80)
        && isReqString(data, 'district', 2, 80)
        && isReqString(data, 'phone', 6, 32)
        && isReqString(data, 'educationQualification', 2, 160)
        && isOptString(data, 'previousExperience', 400)
        && isOptString(data, 'bio', 500)
        && isOptString(data, 'targetInstitutionName', 160)
        && isOptString(data, 'invitationCode', 64)
        && data.permissionsGranted is bool
        && data.status in ['Draft', 'Submitted', 'Under Review', 'Approved', 'Rejected', 'Requires Changes']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPharmacyProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'pharmacyNameAr', 'pharmacyNameEn', 'ownerFullName',
          'responsiblePharmacistName', 'pharmacistSyndicateNumber', 'pharmacyLicenseNumber',
          'licensingAuthority', 'professionalPhone', 'governorate', 'district', 'address',
          'workingDaysAndHours', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'institutionId', 'pharmacyNameAr', 'pharmacyNameEn', 'ownerFullName',
          'responsiblePharmacistName', 'pharmacistSyndicateNumber', 'pharmacyLicenseNumber',
          'licensingAuthority', 'licenseExpiryDate', 'professionalPhone', 'email',
          'governorate', 'district', 'address', 'mapLocationUrl', 'latitude', 'longitude',
          'workingDaysAndHours', 'is24Hours', 'deliveryAvailable', 'pickupAvailable',
          'deliveryZones', 'acceptedPaymentMethods', 'minimumOrderIqd', 'taxNumber',
          'licenseDocuments', 'logoUrl', 'logoPath', 'coverImageUrl', 'coverImagePath',
          'taglineAr', 'taglineEn', 'aboutAr', 'aboutEn', 'publicSlug',
          'promotionalBannerTitleAr', 'promotionalBannerTitleEn', 'promotionalBannerBodyAr',
          'promotionalBannerBodyEn', 'promotionalBannerImageUrl', 'promotionalBannerImagePath',
          'marketingApprovalStatus', 'marketingReviewNote', 'featuredStatus',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && isOptString(data, 'institutionId', 128)
        && isReqString(data, 'pharmacyNameAr', 2, 160)
        && isReqString(data, 'pharmacyNameEn', 2, 160)
        && isReqString(data, 'ownerFullName', 2, 120)
        && isReqString(data, 'responsiblePharmacistName', 2, 120)
        && isReqString(data, 'pharmacistSyndicateNumber', 2, 80)
        && isReqString(data, 'pharmacyLicenseNumber', 2, 80)
        && isReqString(data, 'licensingAuthority', 2, 120)
        && isOptString(data, 'licenseExpiryDate', 24)
        && isReqString(data, 'professionalPhone', 6, 32)
        && isOptString(data, 'email', 254)
        && isReqString(data, 'governorate', 2, 80)
        && isReqString(data, 'district', 2, 80)
        && isReqString(data, 'address', 2, 240)
        && isOptString(data, 'mapLocationUrl', 500)
        && (!('latitude' in data) || data.latitude is number)
        && (!('longitude' in data) || data.longitude is number)
        && isReqString(data, 'workingDaysAndHours', 2, 240)
        && (!('is24Hours' in data) || data.is24Hours is bool)
        && (!('deliveryAvailable' in data) || data.deliveryAvailable is bool)
        && (!('pickupAvailable' in data) || data.pickupAvailable is bool)
        && (!('deliveryZones' in data) || (data.deliveryZones is list && data.deliveryZones.size() <= 50))
        && (!('acceptedPaymentMethods' in data) || (data.acceptedPaymentMethods is list && data.acceptedPaymentMethods.size() <= 5))
        && (!('minimumOrderIqd' in data) || (data.minimumOrderIqd is number && data.minimumOrderIqd >= 0))
        && isOptString(data, 'taxNumber', 80)
        && (!('licenseDocuments' in data) || (data.licenseDocuments is list && data.licenseDocuments.size() <= 10))
        && isOptString(data, 'logoUrl', 1000)
        && isOptString(data, 'logoPath', 400)
        && isOptString(data, 'coverImageUrl', 1000)
        && isOptString(data, 'coverImagePath', 400)
        && isOptString(data, 'taglineAr', 200)
        && isOptString(data, 'taglineEn', 200)
        && isOptString(data, 'aboutAr', 1200)
        && isOptString(data, 'aboutEn', 1200)
        && isOptString(data, 'publicSlug', 120)
        && isOptString(data, 'promotionalBannerTitleAr', 200)
        && isOptString(data, 'promotionalBannerTitleEn', 200)
        && isOptString(data, 'promotionalBannerBodyAr', 600)
        && isOptString(data, 'promotionalBannerBodyEn', 600)
        && isOptString(data, 'promotionalBannerImageUrl', 1000)
        && isOptString(data, 'promotionalBannerImagePath', 400)
        && (!('marketingApprovalStatus' in data) || data.marketingApprovalStatus in ['draft', 'pending_review', 'approved', 'rejected'])
        && isOptString(data, 'marketingReviewNote', 400)
        && (!('featuredStatus' in data) || data.featuredStatus in ['none', 'requested', 'approved', 'rejected'])
        && data.status in ['Draft', 'Pending Approval', 'Submitted', 'Under Review', 'Approved', 'Rejected', 'Requires Changes', 'Suspended', 'Deactivated']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWholesalerProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'wholesalerNameAr', 'wholesalerNameEn', 'ownerFullName', 'legalEntityName',
          'warehouseLicenseNumber', 'healthAuthorityLicenseNumber', 'licensingAuthority',
          'professionalPhone', 'governorate', 'district', 'warehouseAddress',
          'workingDaysAndHours', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'institutionId', 'wholesalerNameAr', 'wholesalerNameEn', 'ownerFullName',
          'legalEntityName', 'warehouseLicenseNumber', 'healthAuthorityLicenseNumber',
          'licensingAuthority', 'licenseExpiryDate', 'professionalPhone', 'email',
          'governorate', 'district', 'warehouseAddress', 'mapLocationUrl', 'latitude', 'longitude',
          'workingDaysAndHours', 'supportedGovernorates', 'minimumOrderIqd',
          'creditEnabledByDefault', 'licenseDocuments', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && isOptString(data, 'institutionId', 128)
        && isReqString(data, 'wholesalerNameAr', 2, 160)
        && isReqString(data, 'wholesalerNameEn', 2, 160)
        && isReqString(data, 'ownerFullName', 2, 120)
        && isReqString(data, 'legalEntityName', 2, 160)
        && isReqString(data, 'warehouseLicenseNumber', 2, 80)
        && isReqString(data, 'healthAuthorityLicenseNumber', 2, 80)
        && isReqString(data, 'licensingAuthority', 2, 120)
        && isOptString(data, 'licenseExpiryDate', 24)
        && isReqString(data, 'professionalPhone', 6, 32)
        && isOptString(data, 'email', 254)
        && isReqString(data, 'governorate', 2, 80)
        && isReqString(data, 'district', 2, 80)
        && isReqString(data, 'warehouseAddress', 2, 240)
        && isOptString(data, 'mapLocationUrl', 500)
        && (!('latitude' in data) || data.latitude is number)
        && (!('longitude' in data) || data.longitude is number)
        && isReqString(data, 'workingDaysAndHours', 2, 240)
        && (!('supportedGovernorates' in data) || (data.supportedGovernorates is list && data.supportedGovernorates.size() <= 25))
        && (!('minimumOrderIqd' in data) || (data.minimumOrderIqd is number && data.minimumOrderIqd >= 0))
        && (!('creditEnabledByDefault' in data) || data.creditEnabledByDefault is bool)
        && (!('licenseDocuments' in data) || (data.licenseDocuments is list && data.licenseDocuments.size() <= 10))
        && data.status in ['Draft', 'Pending Approval', 'Submitted', 'Under Review', 'Approved', 'Rejected', 'Requires Changes', 'Suspended', 'Deactivated']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRegistrationRequest(data, requestId) {
      return data.keys().hasAll([
          'requestId', 'requestNumber', 'uid', 'applicantEmail', 'applicantName',
          'portalType', 'profilePath', 'status', 'activationRule',
          'acceptedTerms', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requestId', 'requestNumber', 'uid', 'applicantEmail', 'applicantName',
          'portalType', 'profilePath', 'institutionId', 'status', 'activationRule',
          'reviewReason', 'reviewInstructions', 'acceptedTerms',
          'submittedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.requestId)
        && data.requestId == requestId
        && isReqString(data, 'requestNumber', 10, 32)
        && data.requestNumber.matches('^MDR-[0-9]{8}-[A-Z0-9]{6}$')
        && isValidId(data.uid)
        && isReqString(data, 'applicantEmail', 3, 254)
        && isReqString(data, 'applicantName', 2, 120)
        && data.portalType in ['patient', 'doctor', 'lab', 'secretary', 'pharmacy', 'wholesaler']
        && isReqString(data, 'profilePath', 5, 200)
        && isOptString(data, 'institutionId', 128)
        && data.status in ['Draft', 'Submitted', 'Under Review', 'Approved', 'Rejected', 'Requires Changes']
        && data.activationRule in ['patient_instant', 'admin_approval', 'institution_approval']
        && isOptString(data, 'reviewReason', 500)
        && isOptString(data, 'reviewInstructions', 800)
        && data.acceptedTerms == true
        && (!('submittedAt' in data) || data.submittedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInstitution(data, institutionId) {
      return data.keys().hasAll([
          'institutionId', 'ownerUid', 'type', 'nameAr',
          'governorate', 'district', 'address', 'licenseNumber',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'institutionId', 'ownerUid', 'type', 'nameAr', 'nameEn',
          'governorate', 'district', 'address', 'licenseNumber',
          'status', 'subscriptionStatus', 'subscriptionPlan', 'subscriptionExpiresAt',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.institutionId)
        && data.institutionId == institutionId
        && isValidId(data.ownerUid)
        && data.type in ['clinic', 'lab', 'pharmacy', 'wholesaler']
        && isReqString(data, 'nameAr', 2, 160)
        && isOptString(data, 'nameEn', 160)
        && isReqString(data, 'governorate', 2, 80)
        && isReqString(data, 'district', 2, 80)
        && isReqString(data, 'address', 2, 240)
        && isReqString(data, 'licenseNumber', 2, 80)
        && data.status in ['pending_approval', 'active', 'suspended', 'rejected']
        && (!('subscriptionStatus' in data) || data.subscriptionStatus in ['none', 'trial', 'active', 'expired'])
        && isOptString(data, 'subscriptionPlan', 80)
        && isOptString(data, 'subscriptionExpiresAt', 32)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInstitutionMember(data, memberId) {
      return data.keys().hasAll([
          'memberId', 'institutionId', 'uid', 'role', 'status', 'permissions', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'memberId', 'institutionId', 'uid', 'role', 'status', 'permissions', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.memberId)
        && data.memberId == memberId
        && isValidId(data.institutionId)
        && isValidId(data.uid)
        && data.role in ['owner', 'secretary', 'staff']
        && data.status in ['pending_approval', 'active', 'revoked']
        && data.permissions is list && data.permissions.size() <= 15 && (data.permissions.size() == 0 || data.permissions[0] is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRole(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'active', 'grantedBy', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == uid
        && isReqString(data, 'email', 3, 254)
        && data.role == 'super_admin'
        && data.active is bool
        && isOptString(data, 'grantedBy', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data, logId) {
      return data.keys().hasAll(['logId', 'actorUid', 'actorEmail', 'action', 'targetCollection', 'targetId', 'details', 'createdAt'])
        && data.keys().hasOnly(['logId', 'actorUid', 'actorEmail', 'action', 'targetCollection', 'targetId', 'details', 'createdAt'])
        && isValidId(data.logId)
        && data.logId == logId
        && isValidId(data.actorUid)
        && isReqString(data, 'actorEmail', 3, 254)
        && isReqString(data, 'action', 2, 120)
        && isReqString(data, 'targetCollection', 2, 80)
        && isReqString(data, 'targetId', 1, 128)
        && isReqString(data, 'details', 1, 600)
        && data.createdAt is timestamp;
    }

    function isValidAdminMessage(data, messageId) {
      return data.keys().hasAll([
          'messageId', 'senderName', 'senderEmail', 'subject', 'body',
          'category', 'status', 'isRead', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'messageId', 'senderName', 'senderEmail', 'subject', 'body',
          'category', 'status', 'isRead', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.messageId)
        && data.messageId == messageId
        && isReqString(data, 'senderName', 1, 120)
        && isReqString(data, 'senderEmail', 3, 254)
        && isReqString(data, 'subject', 2, 200)
        && isReqString(data, 'body', 2, 2000)
        && data.category in ['system', 'inquiry', 'institution_notice', 'compliance']
        && data.status in ['new', 'read', 'replied', 'archived']
        && data.isRead is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isOwner(uid)
        && isValidId(uid)
        && isValidUserPayload(incoming(), uid)
        && incoming().accountStatus in ['pending_profile', 'profile_completed']
        && incoming().selectedPortal == 'none'
        && incoming().registrationCompleted == false
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidUserPayload(incoming(), uid)
        && (
          isAdmin()
          || (
            isOwner(uid)
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              incoming().accountStatus == existing().accountStatus
              || (incoming().selectedPortal == 'patient' && incoming().accountStatus in ['pending_profile', 'profile_completed', 'active'])
              || (incoming().selectedPortal != 'patient' && incoming().accountStatus in ['pending_profile', 'profile_completed', 'pending_review'])
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'email', 'googleName', 'photoUrl', 'accountStatus',
              'selectedPortal', 'registrationCompleted', 'personalProfileCompleted',
              'fullName', 'dateOfBirth', 'age', 'gender', 'governorate',
              'district', 'address', 'phone', 'avatarUrl', 'avatarPath', 'lastLoginAt', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /patient_profiles/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isOwner(uid)
        && isValidId(uid)
        && isValidPatientProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidPatientProfile(incoming(), uid)
        && (
          isAdmin()
          || (
            isOwner(uid)
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'dateOfBirth', 'gender', 'governorate', 'district',
              'address', 'phone', 'avatarUrl', 'avatarPath',
              'emergencyContactName', 'emergencyContactPhone', 'emergencyContactRelation',
              'preferences', 'acceptedPolicy', 'status', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /doctor_profiles/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isOwner(uid)
        && isValidId(uid)
        && isValidDoctorProfile(incoming(), uid)
        && incoming().status in ['Draft', 'Submitted']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidDoctorProfile(incoming(), uid)
        && (
          isAdmin()
          || (
            isOwner(uid)
            && existing().status in ['Draft', 'Requires Changes', 'Rejected']
            && incoming().status in ['Draft', 'Submitted']
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'dateOfBirth', 'gender', 'avatarUrl', 'avatarPath', 'governorate', 'district',
              'professionalPhone', 'email', 'degree', 'university', 'specialty', 'subSpecialty',
              'experienceYears', 'languages', 'clinicName', 'workAddress', 'workDaysAndHours',
              'consultationDurationMinutes', 'consultationFee', 'hourlyAppointmentLimit',
              'bookingConfirmationMode', 'licenseNumber', 'licensingAuthority', 'licenseExpiryDate',
              'verificationDocuments', 'institutionId', 'status', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /lab_profiles/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isOwner(uid)
        && isValidId(uid)
        && isValidLabProfile(incoming(), uid)
        && incoming().status in ['Draft', 'Submitted']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidLabProfile(incoming(), uid)
        && (
          isAdmin()
          || (
            isOwner(uid)
            && existing().status in ['Draft', 'Requires Changes', 'Rejected']
            && incoming().status in ['Draft', 'Submitted']
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'managerFullName', 'managerDateOfBirth', 'managerGender', 'managerAvatarUrl', 'avatarPath', 'professionalPhone',
              'labNameAr', 'labNameEn', 'directorName', 'governorate', 'district', 'address',
              'mapLocationUrl', 'latitude', 'longitude',
              'licenseNumber', 'licensingAuthority', 'licenseExpiryDate', 'licenseDocuments', 'technicalDirectorName',
              'labServices', 'workDaysAndHours', 'hourlyBookingLimit', 'bookingConfirmationMode',
              'institutionId', 'status', 'updatedAt'
            ])
          )
